# Frontend / Backend URL
NEXT_PUBLIC_SITE_URL=https://fasadof36.ru

# Analytics
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Support
MANAGER_WAIT_TIMEOUT_MS=300000

# VK community API (server-only secrets)
VK_GROUP_ID=
# User access token with VK Market permissions; a community token cannot call market.get.
VK_ACCESS_TOKEN=
VK_CALLBACK_SECRET=
VK_CALLBACK_CONFIRMATION=

# MAX Bot API (server-only secrets)
MAX_BOT_TOKEN=
MAX_CHAT_ID=
MAX_MANAGER_CHAT_ID=

# Authentication
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Runtime
FASADOF_DATA_DIR=/var/lib/fasadof
NODE_USE_SYSTEM_CA=1
PORT=3000
